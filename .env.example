# Client-side default provider: local-whisper | groq | assemblyai
# This is baked into the build by Vite.
VITE_TRANSCRIPTION_PROVIDER=local-whisper

# Server-only provider keys. Never prefix these with VITE_.
GROQ_API_KEY=
ASSEMBLYAI_API_KEY=

# Optional shared passcode for the transcription API.
# If set, the client must send the same value in x-echoflow-passcode.
TRANSCRIBE_PASSCODE=

# Optional comma-separated browser origins allowed to call the API.
# Leave empty for same-origin-only deployments or local development.
ALLOWED_ORIGINS=

# Dropbox sync (client-side PKCE; app key is public).
# Register these redirect URIs in the Dropbox app console:
#   http://localhost:5173/
#   https://your-production-domain/
VITE_DROPBOX_APP_KEY=

