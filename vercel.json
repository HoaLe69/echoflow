{
  "version" : 2,
  "installCommand" : "npm install",
  "buildCommand" : "npm run build",
  "headers" : [
    {
      "source": "/(.*)",
      "headers" : [
        {
          "key" : "Cross-Origin-Opener-Policy",
          "value" : "same-origin"
        },
        {
          "key" : "Cross-Origin-Embedder-Policy",
          "value": "require-corp"
        }
      ]
    }
  ],
  "rewrites": [
    {
      "source": "/((?!api/|assets/|models/|.*\\..*).*)",
      "destination": "/index.html"
    }
  ]
}
